#
# Stopwatch and Timer Tool

# Usage:
# 0~9: Type time
# A: Screen rotation
# C: Clear timer to 00:00
# F: Start timer (either count up or count down)


# Registers allocation
# v0~v4: scratch variables
# v5: LCD blink state (for count down beeping mode)
# v6: minutes
# v7: seconds
# v8: mode (0 - stopped, 1 - count up pause, 2 - count down pause, 3 - count down beeping, 4 - count up, 5 - count down)
# v9: rotated mode
# va~vf: function parameters / in-function scratch registers

: get-font-character
	i := font
	if v9 >= 1 begin
		vb := 160
		i += vb
		i += vb
	end
	vb := 32
	loop
		if va == 0 then
			return
		va -= 1
		i += vb
	again


: blit-two-digits-rotated
	i := tempmem
	bcd ve
	load v2

	va := v1
	get-font-character
	sprite vc vd 0

	va := v2
	get-font-character
	vd -= 14
	sprite vc vd 0
	return

: blit-two-digits
	i := tempmem
	bcd ve
	load v2

	va := v1
	get-font-character
	sprite vc vd 0

	va := v2
	get-font-character
	vc += 14
	sprite vc vd 0
	return

: blit
	clear

	if v9 == 0 begin # Standard orientation
		vc := 3
		vd := 8
		ve := v6
		blit-two-digits

		vc := 35
		vd := 8
		ve := v7
		blit-two-digits
	else # CCW rotated
		vc := 12
		vd := 13
		ve := v6
		blit-two-digits-rotated

		vc := 36
		vd := 13
		ve := v7
		blit-two-digits-rotated
	end

	return


: main
	v6 := 0
	v7 := 0
	v8 := 0
	v9 := 0

	clear
	blit
  loop
		# Timer handling
		if v8 <= 2 begin
			# stopped
			v4 := key
			if v4 <= 9 begin
				i := tempmem
				bcd v6
				load v2 # v1 is higher digit of minute, v2 is lower digit of minute
				v3 := v2 # Now that v3 holds the lower digit of minute
				bcd v7
				load v2 # v1 is higher digit of second, v2 is lower digit of second

				v6 := v1
				v7 := v4
				v0 := 0
				loop
					v6 += v3
					v0 += 1
					if v0 < 10 then
				again
				v0 := 0
				loop
					v7 += v2
					v0 += 1
					if v0 < 10 then
				again
				v8 := 0
				blit
			end
			if v4 == 0x0A begin
				va := 1
				v9 ^= va
				blit
			end
			if v4 == 0x0C begin
				v6 := 0
				v7 := 0
				v8 := 0
				blit
			end
			if v4 == 0x0F begin
				# Promote the second into minute if the second count is >= 60
				if v7 > 59 begin
					if v6 < 99 begin
						v7 -= 60
						v6 += 1
					else # The max value of the timer is clipped at 99:59
						v7 := 59
					end
				end
				# Determine if it's count up or count down mode
				if v8 == 0 begin
					if v6 == 0 begin
						if v7 == 0 then
							v8 := 4 # count up mode
					end
					if v8 == 0 then
						v8 := 5 # count down mode
				else
					v8 += 3
				end
				# Save the original time
				i := old-time
				v0 := v6
				v1 := v7
				save v1
				# Start the counter
				vf := 60
				delay := vf
				# Beep to indicate that it's started
				vf := 10
				buzzer := vf
				blit
			end
		end
		if v8 == 3 begin
			# countdown stopped
			vf := delay
			if vf == 0 begin
				# Runs every second
				vf := 30
				delay := vf
				v0 := 1
				v5 ^= v0
				if v5 == 0 begin
					clear
				else
					buzzer := vf
					blit
				end
			end
			v4 := 0
			loop
				if v4 key begin
					vf := 0
					buzzer := vf
					if v4 == 0x0C begin
						v6 := 0
						v7 := 0
					else
						i := old-time
						load v1
						v6 := v0
						v7 := v1
					end
					v8 := 0
					blit
					# Wait until key release
					loop
						if v4 key then
					again
					v4 := 0x0F # force end the loop
				end
				v4 += 1
				if v4 <= 0x0F then
			again

		end
		if v8 >= 4 begin
			# counting up (4) / counting down (5)
			vf := delay
			if vf == 0 begin
				# Runs every second
				vf := 60
				delay := vf

				if v8 == 4 begin
					# counting up
					v7 += 1
					if v7 >= 60 begin
						v7 := 0
						v6 += 1
					end
					if v6 > 99 begin
						v6 := 99
						v7 := 59
					end
					v0 := 0xF
				else # v8 == 5
					# counting down
					v7 -= 1
					if v7 == 0 begin
						if v6 == 0 begin
							v8 := 3
							v5 := 1
							vf := 30
							delay := vf
							buzzer := vf
						end
					end
					if v8 == 5 begin
						if v7 == 0xFF begin
							v6 -= 1
							v7 := 59 # seconds = 59
						end
					end
				end
				blit
			end

			v0 := 0x0F
			if v0 key begin
				v8 -= 3
				vf := 10
				buzzer := vf
				# Wait until button release
				loop
					if v0 key then
				again
			end
		end
	again

